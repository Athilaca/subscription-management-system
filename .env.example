DJANGO_SETTINGS_MODULE=brightloop.settings.dev
SECRET_KEY=change-me-in-production
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=brightloop
POSTGRES_USER=brightloop
POSTGRES_PASSWORD=brightloop
DATABASE_URL=postgres://brightloop:brightloop@db:5432/brightloop

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
TIME_ZONE=UTC

# Used by `createsuperuser --noinput` and seed_demo
DJANGO_SUPERUSER_EMAIL=admin@brightloop.local
DJANGO_SUPERUSER_PASSWORD=Admin123!Aa

# Development email: passwords resets print to the console instead of sending
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
